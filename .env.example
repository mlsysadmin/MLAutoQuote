# ─────────────────────────────────────────────────────────────────────────────
# M Lhuillier AutoQuote — environment
# Copy to `.env` for local development. In production these are set as Cloud Run
# environment variables / Secret Manager references (see DEPLOYMENT.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (MySQL on your machine or in Docker):
DATABASE_URL="mysql://root:password@localhost:3306/ml_autoquote"
# Cloud Run + Cloud SQL (unix socket):
# DATABASE_URL="mysql://appuser:PASSWORD@localhost/ml_autoquote?socket=/cloudsql/PROJECT:REGION:INSTANCE"

# ── Sessions ────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin of the app, used to build customer offer links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Photo storage ───────────────────────────────────────────────────────────
# "gcs"   — Google Cloud Storage with V4 signed direct uploads (production)
# "local" — writes to ./.uploads (development only)
STORAGE_DRIVER="local"
GCS_BUCKET=""
# Optional: only needed when running outside Google Cloud (local dev against GCS).
# GOOGLE_APPLICATION_CREDENTIALS="./gcp-key.json"
# Service account used to sign upload URLs when running on Cloud Run.
# GCS_SIGNER_EMAIL="ml-autoquote@PROJECT.iam.gserviceaccount.com"

# ── Comparable listings (valuation input) ───────────────────────────────────
# Comma-separated, in priority order: partner,manual,seed
# - partner : licensed marketplace data feed (see COMPARABLES_API_URL)
# - manual  : links + prices entered by the appraisal team / ingest API
# - seed    : built-in reference dataset, for demo and as a last-resort fallback
COMPARABLES_PROVIDERS="manual,seed"

# Licensed marketplace data feed (leave blank to disable the partner provider).
COMPARABLES_API_URL=""
COMPARABLES_API_KEY=""

# Shared secret for POST /api/ingest/comparables (the collector endpoint your
# ops team or an approved data partner posts listings to). Leave blank to disable.
COMPARABLES_INGEST_TOKEN=""

# ── Valuation policy ────────────────────────────────────────────────────────
# Buy margin: the share of the mid market price the system starts from.
VALUATION_BUY_MARGIN="0.82"
# How many days an offer stays valid once the appraiser sends it.
OFFER_VALIDITY_DAYS="7"

# ── Misc ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
