# ─────────────────────────────────────────────────────────────────────────────
# M Lhuillier AutoQuote — environment
# Copy to `.env` for local development. In production these are set as Cloud Run
# environment variables / Secret Manager references (see DEPLOYMENT.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (MySQL on your machine or in Docker):
DATABASE_URL="mysql://autoquote:1234567890@127.0.0.1:3306/ml_autoquote"
# Cloud Run + Cloud SQL (unix socket):
# DATABASE_URL="mysql://appuser:PASSWORD@localhost/ml_autoquote?socket=/cloudsql/PROJECT:REGION:INSTANCE"

# ── Sessions ────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin of the app, used to build customer offer links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Photo storage ───────────────────────────────────────────────────────────
# "gcs"   — Google Cloud Storage with V4 signed direct uploads (production)
# "local" — writes to ./.uploads (development only)
STORAGE_DRIVER="local"
GCS_BUCKET=""
# Optional: only needed when running outside Google Cloud (local dev against GCS).
# GOOGLE_APPLICATION_CREDENTIALS="./gcp-key.json"
# Service account used to sign upload URLs when running on Cloud Run.
# GCS_SIGNER_EMAIL="ml-autoquote@PROJECT.iam.gserviceaccount.com"

# ── Comparable listings (valuation input) ───────────────────────────────────
# Comma-separated, in priority order: partner,manual,seed
# - partner : licensed marketplace data feed (see COMPARABLES_API_URL)
# - manual  : links + prices entered by the appraisal team / ingest API
# - seed    : built-in reference dataset, for demo and as a last-resort fallback
COMPARABLES_PROVIDERS="manual,seed"

# Licensed marketplace data feed (leave blank to disable the partner provider).
COMPARABLES_API_URL=""
COMPARABLES_API_KEY=""

# Shared secret for POST /api/ingest/comparables (the collector endpoint your
# ops team or an approved data partner posts listings to). Leave blank to disable.
COMPARABLES_INGEST_TOKEN=""

# ── Valuation policy ────────────────────────────────────────────────────────
# Buy margin: the share of the mid market price the system starts from.
VALUATION_BUY_MARGIN="0.82"
# How many days an offer stays valid once the appraiser sends it.
OFFER_VALIDITY_DAYS="7"

# ── Misc ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"

# ── Staff sign-in ───────────────────────────────────────────────────────────
# Development only: accept an empty password on the appraiser portal, so nobody
# has to type one while building or demonstrating. Hard-wired off in production.
AUTH_ALLOW_BLANK_PASSWORD="false"

# ── Reading the customer's government ID ────────────────────────────────────
# Pre-fills name, date of birth, ID type and ID number from the ID photo the
# customer uploads, so the last step is one field instead of five. Whatever is
# read is shown to the customer to confirm — it is never taken as fact.
#
#   unset    — ON, always. Picks the best reader available: Cloud Vision when
#              running on Cloud Run or GOOGLE_VISION_API_KEY is set, then the
#              vision model when ANTHROPIC_API_KEY is set, then on-device OCR,
#              which needs nothing. So reading works out of the box; adding a
#              credential only makes it better.
#   "vision" — force Cloud Vision OCR. The image stays in your own GCP project.
#   "claude" — force the vision model. Best on creased or angled cards; the
#              image is sent to a third party.
#   "local"  — force Tesseract, in-process. No credentials and no outbound
#              call with an ID attached, at the cost of accuracy on a bad
#              photo. Measured on the production build: ~0.9s for the first
#              read in a container while the worker starts, ~0.35s after.
#   "off"    — disable it. The customer types the five fields instead.
ID_EXTRACTION_PROVIDER=""
# GOOGLE_VISION_API_KEY=""   # only for local dev; on Cloud Run the service account is used
# ANTHROPIC_API_KEY=""
# ID_EXTRACTION_MODEL="claude-opus-5-5"   # claude-haiku-5-5 is cheaper and usually enough

# ── Customer notifications ──────────────────────────────────────────────────
# A confirmation goes out when a submission arrives, and again when the
# appraiser releases the offer. Without these, messages are written to the log
# instead of being delivered.
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
